{
  "uid": "phase3-rabbitmq",
  "title": "Phase 3 \u2014 RabbitMQ cluster",
  "tags": [
    "phase-3",
    "rabbitmq"
  ],
  "description": "rabbitmq_prometheus on :15692. /metrics is aggregated and constant-cardinality; per-queue numbers come from /metrics/detailed with three named families.",
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Queue",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages ready / unacked \u2014 orders",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_messages_ready)",
          "legendFormat": "ready",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_messages_unacked)",
          "legendFormat": "unacked",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Only on /metrics/detailed, and only because queue_coarse_metrics is named in the scrape config. Summed across nodes: a quorum queue reports from its leader."
    },
    {
      "type": "timeseries",
      "title": "Consumers",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_consumers)",
          "legendFormat": "consumers",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Zero here with a climbing backlog is the shape of a dead worker."
    },
    {
      "type": "timeseries",
      "title": "Queue memory",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_process_memory_bytes)",
          "legendFormat": "bytes",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Throughput",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Publish / deliver / ack",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_global_messages_received_total[2m]))",
          "legendFormat": "published",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_global_messages_delivered_total[2m]))",
          "legendFormat": "delivered",
          "refId": "B",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total[2m]))",
          "legendFormat": "acked",
          "refId": "C",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "cps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "By queue type",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue_type) (rate(rabbitmq_global_messages_delivered_total[2m]))",
          "legendFormat": "{{queue_type}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "cps"
        },
        "overrides": []
      },
      "description": "rabbit_quorum_queue is the one carrying traffic. If rabbit_classic_queue is moving, the app declared the wrong type."
    },
    {
      "type": "row",
      "title": "Cluster health",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Unreachable peers",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_unreachable_cluster_peers_count",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Non-zero on every node of a partition. The closest thing rabbitmq_prometheus has to a partition alarm.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Alarms",
      "gridPos": {
        "x": 6,
        "y": 15,
        "w": 9,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_alarms_memory_used_watermark",
          "legendFormat": "mem {{instance}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_alarms_free_disk_space_watermark",
          "legendFormat": "disk {{instance}}",
          "refId": "B",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_alarms_file_descriptor_limit",
          "legendFormat": "fd {{instance}}",
          "refId": "C",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "1 means publishers on that node are blocked.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "File descriptors",
      "gridPos": {
        "x": 15,
        "y": 15,
        "w": 9,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_process_open_fds",
          "legendFormat": "open {{instance}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_process_max_fds",
          "legendFormat": "limit {{instance}}",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Raft \u2014 quorum queue log",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rabbitmq_raft_term_total)",
          "legendFormat": "term {{instance}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rabbitmq_raft_elections_total)",
          "legendFormat": "elections {{instance}}",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Quorum queues are Raft logs. Note the _total suffix: these are counters, and the OTLP-to-Prometheus translation appends it \u2014 the same renaming as phase 1's orders_created_total, now happening to metrics that were already Prometheus metrics on the wire."
    },
    {
      "type": "timeseries",
      "title": "Connections and channels",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_connections",
          "legendFormat": "connections {{instance}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_channels",
          "legendFormat": "channels {{instance}}",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "brokers",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"rabbitmq\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ]
}